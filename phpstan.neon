parameters:
    level: 8
    paths:
        - redirection.php
        - redirection-admin.php
        - redirection-capabilities.php
        - redirection-cli.php
        - redirection-front.php
        - redirection-settings.php
        - matches
        - modules
        - includes
        - models
    excludePaths:
        - vendor

    bootstrapFiles:
        - redirection-version.php

    dynamicConstantNames:
        - WP_CLI

    phpVersion: 70400
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false

    parallel:
        maximumNumberOfProcesses: 4

    disallowedFunctionCalls:
        -
            function: 'var_dump()'
            message: 'forgot about it? if needed just add a phpstan ignore line'
        -
            function: 'print_r()'
            message: 'forgot about it? if needed just add a phpstan ignore line'
        -
            function: 'error_log()'
            message: 'forgot about it? if needed just add a phpstan ignore line'
        -
            function: 'debug_print_var()'
            message: 'forgot about it? if needed just add a phpstan ignore line'

    universalObjectCratesClasses:
        - stdClass

    customRulesetUsed: true

    ignoreErrors:
        -
            identifier: arrayFilter.strict
        -
            identifier: empty.notAllowed
        -
            identifier: ternary.condNotBoolean
        -
            message: '#PHPDoc tag @api(Define|Error|ErrorExample|Success|Param|Name|Description|Group|Success) has invalid value#'
            path: api/api.php
