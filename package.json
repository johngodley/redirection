{
	"name": "redirection",
	"version": "5.9.0",
	"description": "Redirection is a WordPress plugin to manage 301 redirections and keep track of 404 errors without requiring knowledge of Apache .htaccess files.",
	"main": "redirection.php",
	"browser": {
		"redirection.php": false
	},
	"sideEffects": [
		"*.css",
		"*.scss",
		"src/index.tsx",
		"src/app.tsx"
	],
	"scripts": {
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"build:analyze": "ANALYZE=true pnpm build",
		"build:stats": "wp-scripts build --webpack-bundle-analyzer",
		"doc": "redocly build-docs dev/openapi.yaml -o release/api-doc.html --theme.openapi.nativeScrollbars=true",
		"plugin": "pnpm build && rm -rf release && mkdir -p release/redirection && cp -R *.php changelog.txt readme.txt build license.txt includes modules models matches images database api actions release/redirection && rm release/redirection/rector.php",
		"plugin:zip": "pnpm plugin && cd release && zip -r redirection.zip redirection",
		"release": "bash dev/release-github.sh",
		"release:svn": "pnpm plugin:zip && dev/svn.sh $npm_package_version",
		"lint": "pnpm lint:css && pnpm lint:js && pnpm lint:ts && pnpm lint:php",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:fix": "wp-scripts lint-js --fix",
		"lint:ts": "tsc --noEmit",
		"lint:php": "composer run-script checks",
		"test": "pnpm test:js && pnpm test:unit && pnpm test:integration",
		"test:unit": "composer run test-unit",
		"test:integration": "wp-env run cli --env-cwd=wp-content/plugins/redirection composer run test-integration",
		"test:js": "wp-scripts test-unit-js",
		"test:e2e": "NODE_ENV=e2e jest --config=e2e-jest.js --testPathIgnorePatterns='/node_modules/|/client/' --testTimeout=30000 e2e",
		"wp-env:start": "wp-env start",
		"wp-env:destroy": "wp-env destroy"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/johngodley/redirection.git"
	},
	"author": "John Godley",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/johngodley/redirection/issues"
	},
	"homepage": "https://github.com/johngodley/redirection",
	"devDependencies": {
		"@hookform/resolvers": "^5.4.0",
		"@redocly/cli": "^1.34.15",
		"@tanstack/eslint-plugin-query": "^5.101.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/jest": "^30.0.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@types/react-highlight-words": "^0.20.1",
		"@wordpress/base-styles": "^6.20.0",
		"@wordpress/env": "^10.39.0",
		"@wordpress/eslint-plugin": "^24.5.0",
		"@wordpress/jest-preset-default": "^12.50.0",
		"@wordpress/prettier-config": "^4.50.0",
		"@wordpress/scripts": "^31.8.0",
		"autoprefixer": "^10.5.2",
		"chai": "^6.2.2",
		"css-loader": "^7.1.4",
		"download": "^8.0.0",
		"enzyme": "^3.11.0",
		"enzyme-to-json": "^3.6.2",
		"eslint-import-resolver-node": "0.3.9",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-eslint-comments": "3.2.0",
		"eslint-plugin-import": "2.32.0",
		"html-webpack-plugin": "^5.6.7",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"json-loader": "^0.5.7",
		"mini-css-extract-plugin": "^2.10.2",
		"node-fetch": "^2.7.0",
		"npm-check-updates": "^19.6.6",
		"path": "^0.12.7",
		"postcss": "^8.5.16",
		"postcss-focus": "^7.0.0",
		"postcss-loader": "^8.2.1",
		"postcss-preset-env": "^10.6.1",
		"postcss-reporter": "^7.1.0",
		"prettier": "npm:wp-prettier@3.0.3",
		"rtlcss": "^4.3.0",
		"sass-loader": "^16.0.8",
		"style-loader": "4.0.0",
		"stylelint": "^16.26.1",
		"terser-webpack-plugin": "^5.6.1",
		"typescript": "^5.9.3",
		"webpack": "^5.108.3",
		"webpack-bundle-analyzer": "^5.3.0",
		"webpack-bundle-size-analyzer": "^3.1.0"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@headlessui/react": "^2.2.10",
		"@tanstack/react-query": "^5.101.2",
		"@tanstack/react-query-devtools": "^5.101.2",
		"@wordpress/element": "^6.46.0",
		"@wordpress/i18n": "^6.23.0",
		"classnames": "^2.5.1",
		"clsx": "^2.1.1",
		"immer": "^11.1.9",
		"rc-progress": "^4.0.0",
		"rc-util": "^5.44.4",
		"react": "^18.3.1",
		"react-day-picker": "^9.14.0",
		"react-dom": "^18.3.1",
		"react-focus-lock": "^2.13.7",
		"react-highlight-words": "^0.21.0",
		"react-popper": "^2.3.0",
		"react-textarea-autosize": "^8.5.9",
		"use-debounce": "^10.1.1",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"wordpress": {
		"supported": "6.6"
	},
	"pnpm": {
		"overrides": {
			"webpack": "$webpack"
		}
	},
	"packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800"
}
