{
	"name": "redirection",
	"version": "5.6.0",
	"description": "Redirection is a WordPress plugin to manage 301 redirections and keep track of 404 errors without requiring knowledge of Apache .htaccess files.",
	"main": "redirection.php",
	"browser": {
		"redirection.php": false
	},
	"sideEffects": true,
	"scripts": {
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"plugin": "pnpm build && rm -rf release && mkdir -p release/redirection && cp -R *.php changelog.txt readme.txt build license.txt modules models matches images fileio database api actions release/redirection && rm release/redirection/api/*.md",
		"plugin:zip": "pnpm plugin && cd release && zip -r redirection.zip redirection",
		"release": "pnpm plugin:zip && release-it",
		"release:svn": "pnpm plugin:zip && dev/svn.sh $npm_package_version",
		"lint": "pnpm lint:css && pnpm lint:js && pnpm lint:ts && pnpm lint:php",
		"lint:css": "echo wp-scripts lint-style",
		"lint:js": "echo wp-scripts lint-js",
		"lint:ts": "echo tsc --noEmit",
		"lint:php": "composer run-script checks",
		"test": "pnpm test:js && pnpm test:unit && pnpm test:integration",
		"test:unit": "composer run test-unit",
		"test:integration": "wp-env run cli --env-cwd=wp-content/plugins/redirection composer run test-integration",
		"test:js": "echo wp-scripts test-unit-js",
		"test:e2e": "NODE_ENV=e2e jest --config=e2e-jest.js --testPathIgnorePatterns='/node_modules/|/client/' --testTimeout=30000 e2e",
		"wp-env:start": "wp-env start",
		"wp-env:destroy": "wp-env destroy",
		"doc": "apidoc -v -i api/ -o ./api-doc/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/johngodley/redirection.git"
	},
	"author": "John Godley",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/johngodley/redirection/issues"
	},
	"homepage": "https://github.com/johngodley/redirection",
	"devDependencies": {
		"@babel/core": "^7.28.6",
		"@babel/plugin-proposal-class-properties": "^7.18.6",
		"@babel/preset-env": "^7.28.6",
		"@babel/preset-react": "^7.28.5",
		"@babel/preset-typescript": "^7.28.5",
		"@redux-devtools/extension": "^3.3.0",
		"@tanstack/eslint-plugin-query": "^5.91.2",
		"@types/react": "^18.3.27",
		"@types/react-dom": "^18.3.7",
		"@types/react-highlight-words": "^0.20.1",
		"@types/react-redux": "^7.1.34",
		"@wordpress/base-styles": "^6.14.0",
		"@wordpress/env": "^10.38.0",
		"@wordpress/eslint-plugin": "^22.22.0",
		"@wordpress/jest-preset-default": "^12.38.0",
		"@wordpress/prettier-config": "^4.38.0",
		"@wordpress/scripts": "^30.27.0",
		"apidoc": "^1.2.0",
		"autoprefixer": "^10.4.23",
		"babel-core": "7.0.0-bridge.0",
		"babel-eslint": "^10.1.0",
		"babel-jest": "^30.2.0",
		"babel-loader": "^10.0.0",
		"chai": "^6.2.2",
		"css-loader": "^7.1.2",
		"download": "^8.0.0",
		"enzyme": "^3.11.0",
		"enzyme-to-json": "^3.6.2",
		"eslint-import-resolver-node": "0.3.9",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-eslint-comments": "3.2.0",
		"eslint-plugin-import": "2.32.0",
		"html-webpack-plugin": "^5.6.5",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"json-loader": "^0.5.7",
		"mocha": "^11.7.5",
		"node-fetch": "^2.7.0",
		"npm-check-updates": "^19.3.1",
		"path": "^0.12.7",
		"postcss": "^8.5.6",
		"postcss-focus": "^7.0.0",
		"postcss-loader": "^8.2.0",
		"postcss-preset-env": "^10.6.1",
		"postcss-reporter": "^7.1.0",
		"prettier": "npm:wp-prettier@3.0.3",
		"prop-types": "^15.8.1",
		"redux-devtools-extension": "^2.13.9",
		"release-it": "^19.2.3",
		"request-promise": "^4.2.6",
		"sass-loader": "^16.0.6",
		"style-loader": "4.0.0",
		"stylelint": "^16.26.1",
		"stylelint-config-wordpress": "^17.0.0",
		"underscore": "^1.13.7",
		"webpack": "^5.104.1",
		"webpack-bundle-analyzer": "^4.10.2",
		"webpack-bundle-size-analyzer": "^3.1.0",
		"webpack-cli": "^6.0.1",
		"webpack-shell-plugin-next": "^2.3.3"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@headlessui/react": "^2.2.9",
		"@wordpress/element": "^6.38.0",
		"@wordpress/i18n": "^6.11.0",
		"classnames": "^2.5.1",
		"clsx": "^2.1.1",
		"deep-equal": "^2.2.3",
		"lru": "^3.1.0",
		"qs": "^6.14.1",
		"rc-progress": "^4.0.0",
		"rc-util": "^5.44.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-dropzone": "^14.3.8",
		"react-focus-lock": "^2.13.7",
		"react-highlight-words": "^0.21.0",
		"react-popper": "^2.3.0",
		"react-redux": "^9.2.0",
		"react-textarea-autosize": "^8.5.9",
		"redux": "^5.0.1",
		"redux-thunk": "^3.1.0",
		"request": "^2.88.2",
		"typescript": "^5.9.3",
		"url": "^0.11.4",
		"use-debounce": "^10.1.0"
	},
	"jest": {
		"modulePaths": [
			"./client"
		],
		"moduleNameMapper": {
			"^.+\\.(css|less|scss)$": "babel-jest",
			"^node:(.*)$": "$1"
		},
		"testEnvironment": "jsdom",
		"transformIgnorePatterns": []
	},
	"apidoc": {
		"name": "Redirection REST API",
		"version": "0.1.0",
		"description": "WordPress REST API documentation for Redirection",
		"title": "Redirection REST API",
		"url": "https://redirection.me/wp-json",
		"header": {
			"title": "Introduction",
			"filename": "./api/header.md"
		},
		"footer": {
			"filename": "./api/footer.md"
		},
		"template": {
			"withCompare": false
		}
	},
	"wordpress": {
		"supported": "6.4"
	},
	"engines": {
		"node": ">=12.14.0",
		"npm": ">=6.14.8"
	},
	"release-it": {
		"github": {
			"assets": [
				"dist/redirection.zip"
			]
		},
		"npm": false
	}
}
